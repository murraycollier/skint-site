# Copy to .env and edit. Leave APP_PASSWORD empty to turn off the sign-in screen.
APP_USER=admin
APP_PASSWORD=change-me
# Domain(s) the app answers to, comma-separated. Requests for any other host (such as the IP address) are refused.
ALLOWED_HOSTS=skint.technomuz.com,localhost
# Days a browser is remembered after a two-step code (0 = ask for a code at every sign-in)
MFA_REMEMBER_DAYS=7
